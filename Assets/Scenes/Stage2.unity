--- !u!102 &149679124
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 149679122}
  m_Text: 'Hull breach ahead! When the countdown

    starts: B steers the floating
    power cell

    onto the floor socket, A restores

    gravity to seat it, then
    BOTH stand on

    the console pads.'
