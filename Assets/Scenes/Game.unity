  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 832029304}
  m_Text: "Hull breach \u2014 the room is ZERO-G and a\ncountdown starts!\n1) B:
    aim at the floating power cell,\nhold Right Shift and steer it over the\nglowing
    floor socket.\n2) A: press E to switch the room's\ngravity DOWN so the cell drops
    in.\n3) Stand on both console pads to open\nthe door."
