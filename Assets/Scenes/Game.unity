    fov: 24
  lines:
  - time: 1.5
    duration: 4.2
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: Somewhere in the Shattered Orbit, a small cargo ship limps home...
  - time: 8.6
    duration: 2.2
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: What was that?!
  - time: 10.9
    duration: 2.6
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: "The engine's gone critical \u2014 hold on, we're going down!"
  - time: 14.2
    duration: 3.6
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: Emergency landing on a broken launch platform.
  - time: 20.2
    duration: 2.4
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Everyone in one piece? ...Good.
  - time: 22.8
    duration: 2.8
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: The engine core is fried. Help me pull it out.
  - time: 25.7
    duration: 2.2
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: "On three \u2014 push!"
  - time: 28.4
    duration: 2.8
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: No spare on board... but the scanner found one.
  - time: 31.3
    duration: 2.6
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: In that abandoned station. Across all of that wreckage.
  - time: 33.9
    duration: 2.4
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: You bend the gravity, I'll hold things still. Let's go.
  moves:
