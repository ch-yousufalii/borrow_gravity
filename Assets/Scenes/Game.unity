TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2012797426}
  m_Text: "Cargo slides down the lane \u2014 wait in a\nside bay (toward the camera)
    until it\npasses, then run.\nAt the exit, walk past the jammed\ncontainer on
    the near side. A: press E\nto make its field ZERO-G if you want it\nto float
    out of the way."
  m_OffsetZ: 0
  m_CharacterSize: 0.012
