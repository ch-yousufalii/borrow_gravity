  m_Name: 
  m_EditorClassIdentifier: 
  stageNumber: 2
  stageTitle: "STAGE 2 \u2014 THE UPSIDE-DOWN STATION"
  objective: 1
  objectiveText: Find the Engine
  introText: 'The station''s gravity generators have gone haywire. Rooms flip, cargo
    drifts, walls become floors.


    Fight your way through the facility to the
    engine vault. A still bends gravity in the marked fields; B still freezes and
    steers loose objects.'
  completeTitle: ENGINE FOUND
  completeText: "The replacement engine is free \u2014 and the whole station shudders.
    Alarms everywhere: it's entering a critical state.\nGet the engine back to the
    ship before it falls apart!"
  isFinalStage: 0
  holdToResetSeconds: 1
  playAmbience: 1
  autoContinueAfter: 4
  autoStartAfter: 8
