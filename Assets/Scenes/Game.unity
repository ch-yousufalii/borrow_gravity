  m_Script: {fileID: 11500000, guid: ce4a3bf766ca789859139450aa81f151, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  message: "Cargo slides down the lane \u2014 wait in a side bay (toward the camera)
    until it passes, then run.\nAt the exit, walk past the jammed container on the
    near side. A: press E to make its field ZERO-G if you want it to float out of
    the way."
  duration: 11
  sectionTitle: 6.3  Magnetic Cargo Lane
  once: 1
