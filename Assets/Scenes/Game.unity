--- !u!102 &839368249
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 839368247}
  m_Text: 'The lift is stuck: it''s overloaded and

    its counterweight is adrift.

    B:
    steer the heavy crate off the lift

    and the counterweight over the tray (the

    shaft
    is weightless). A: restore gravity

    to set them down.'
  m_OffsetZ: 0
  m_CharacterSize: 0.012
  m_LineSpacing: 1
