--- !u!102 &2055437808
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2055437806}
  m_Text: "Cargo slides down the magnetic lane \u2014\nstep into the side bays (toward
    the\ncamera) to let it pass.\nA jammed container blocks the exit: A\nzeroes its
    gravity, B steers it into the\nback bay."
