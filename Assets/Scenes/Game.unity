TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1098562315}
  m_Text: 'No floor across the gap. Step onto the

    ferry. B: freeze the ferry
    and steer it

    across. A: switch the landing field UP

    to lift it into
    the dock.'
