  - time: 19
    position: {x: 150, y: 6, z: -16}
    lookAt: {x: 172, y: 9, z: 10}
    fov: 40
  - time: 25
    position: {x: 148, y: 8, z: -18}
    lookAt: {x: 260, y: 40, z: 45}
    fov: 30
  - time: 34
    position: {x: 148, y: 9, z: -18}
    lookAt: {x: 300, y: 52, z: 55}
    fov: 26
  lines:
  - time: 1.6
    duration: 2.9
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: Back at the docking platform, with a brand-new engine...
  - time: 4.7
    duration: 2.1
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Got your half? Don't drop it now...
  - time: 7
    duration: 2.4
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: "Wouldn't dream of it. Bay's open \u2014 both halves in!"
  - time: 9.6
    duration: 1.5
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Locking mine in... now!
  - time: 11.3
    duration: 2.1
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: Engine's online! Listen to that hum.
  - time: 13.6
    duration: 2.2
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Then let's go home. Together.
  - time: 16.3
    duration: 2
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: "Station's coming apart \u2014 punch it!"
  - time: 20.5
    duration: 3.8
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: "Two travellers, one borrowed gravity \u2014 and a ship that flies again."
  - time: 24.6
    duration: 2
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Next time, we bring a spare.
  moves:
  - actor: {fileID: 566841729}
    time: 0
    duration: 7
    fromPos: {x: 152, y: 0.72, z: -0.6}
    toPos: {x: 160, y: 0.72, z: -0.6}
    fromEuler: {x: 0, y: 90, z: 0}
    toEuler: {x: 0, y: 90, z: 0}
