  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2057503399}
  m_Text: 'The impact knocked the island out of

    reach!

    A: zero its zone
    so it floats up. B:

    freeze it level with the path and steer

    it back
    in line.'
