  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 295389524}
  m_Text: 'A slab floats in zero-g over the tilting

    platform.

    A: press
    E to switch the zone''s gravity

    DOWN. B: face the slab, tap Right Shift

    to
    freeze it, HOLD to steer it next to

    the ledge.'
