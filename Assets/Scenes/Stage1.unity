--- !u!102 &1141772598
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1141772596}
  m_Text: 'A slab floats in zero-g over the tilting

    platform.

    A: press
    E to switch the zone''s gravity

    DOWN. B: face the slab, tap Right Shift

    to
    freeze it, HOLD to steer it next to

    the ledge.'
