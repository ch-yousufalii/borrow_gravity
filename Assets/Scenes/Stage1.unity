  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1325835893}
  m_Text: "These platforms power down one by one\nonce someone steps on the first.
    Set up\nthe key platform first:\nA zeroes its zone, B freezes it at the\nright
    height and steers it into the gap\n\u2014 then run together!"
