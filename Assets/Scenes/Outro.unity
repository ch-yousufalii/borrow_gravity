  lines:
  - time: 1.6
    duration: 3
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: Back at the docking platform, with a brand-new engine...
  - time: 4.6
    duration: 2.4
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Easy... keep it level...
  - time: 7.2
    duration: 2.2
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: "Bay's open \u2014 slide it in!"
  - time: 11.2
    duration: 2.2
    speaker: A
    color: {r: 1, g: 0.62, b: 0.36, a: 1}
    text: Engine's online!
  - time: 13.6
    duration: 2.4
    speaker: B
    color: {r: 0.36, g: 0.88, b: 1, a: 1}
    text: Then let's go home. Together.
  - time: 20.5
    duration: 4
    speaker: 
    color: {r: 0.8, g: 0.75, b: 0.9, a: 1}
    text: "Two travellers, one borrowed gravity \u2014 and a ship that flies again."
