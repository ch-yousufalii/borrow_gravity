  m_Name: 
  m_EditorClassIdentifier: 
  stageNumber: 7
  stageTitle: "STAGE 7 \u2014 THE WARDEN"
  objective: 2
  objectiveText: Destroy the Warden
  introText: 'Your ship is just past this platform, the engine is in your hands,
    and the graveyard''s old security machine has you cornered.


    Nothing you
    have can scratch it, unless you strike together. B freezes it. A changes gravity
    while it''s frozen, and the shift tears at its frame.


    Three hits. Then
    run.'
  completeTitle: YOU MADE IT
  completeText: The Warden is scrap, the engine is back in the ship, and it's time
    to go home.
  isFinalStage: 1
  holdToResetSeconds: 1
  playAmbience: 1
  autoContinueAfter: 4
  autoStartAfter: 8
